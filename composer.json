{
    "name": "hosmelq/php-coding-standard",
    "description": "Opinionated ECS, Rector, and PHPStan presets for PHP and Laravel packages and applications.",
    "license": "MIT",
    "keywords": [
        "code-style",
        "coding-standard",
        "dev",
        "easy-coding-standard",
        "ecs",
        "laravel",
        "pest",
        "php",
        "php-cs-fixer",
        "phpstan",
        "rector",
        "static analysis"
    ],
    "authors": [
        {
            "name": "Hosmel Quintana",
            "email": "hosmelq@gmail.com"
        }
    ],
    "homepage": "https://github.com/hosmelq/php-coding-standard",
    "support": {
        "docs": "https://github.com/hosmelq/php-coding-standard#readme"
    },
    "require": {
        "php": "^8.4",
        "driftingly/rector-laravel": "^2.7.3",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "laravel/pao": "^1.1.6",
        "nesbot/carbon": "^3.15.1",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.7",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-strict-rules": "^2.1.1",
        "rector/rector": "^2.8.5",
        "spaze/phpstan-disallowed-calls": "^4.15.1",
        "symplify/easy-coding-standard": "^13.3.23",
        "thecodingmachine/phpstan-safe-rule": "^1.4.7",
        "thecodingmachine/safe": "^3.4.0",
        "ticketswap/phpstan-error-formatter": "^1.3.0",
        "tomasvotruba/type-coverage": "^2.5.1"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.57.0",
        "pestphp/pest": "^5.3.6",
        "pestphp/pest-plugin-agent": "^5.0.0",
        "pestphp/pest-plugin-rector": "^5.0.6",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "symfony/process": "^8.1.10"
    },
    "conflict": {
        "fakerphp/faker": "<1.24",
        "symfony/event-dispatcher-contracts": "<2.5.4 || >=3.0 <3.5",
        "symfony/translation": "<6.4.8 || >=7.0 <7.0.8",
        "symfony/translation-contracts": "<2.5.4 || >=3.0 <3.5"
    },
    "suggest": {
        "pestphp/pest-plugin-rector": "Required by the RECTOR_PEST preset (Pest 5+)."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "HosmelQ\\PhpCodingStandard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HosmelQ\\PhpCodingStandard\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "ecs": "ecs check --fix",
        "phpstan": "phpstan analyse --memory-limit=4G",
        "rector": "rector",
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "scripts-descriptions": {
        "ecs": "Runs ECS.",
        "phpstan": "Runs PHPStan analyse.",
        "rector": "Runs Rector.",
        "test": "Runs the Pest test suite.",
        "test-coverage": "Runs the Pest test suite with code coverage."
    },
    "$schema": "https://getcomposer.org/schema.json"
}
