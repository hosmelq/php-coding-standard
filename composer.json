{
  "name": "hosmelq/php-coding-standard",
  "description": "Opinionated ECS, Rector, and PHPStan presets for PHP and Laravel packages and applications.",
  "license": "MIT",
  "keywords": [
    "code-style",
    "coding-standard",
    "dev",
    "easy-coding-standard",
    "ecs",
    "laravel",
    "pest",
    "php",
    "php-cs-fixer",
    "phpstan",
    "rector",
    "static analysis"
  ],
  "authors": [
    {
      "name": "Hosmel Quintana",
      "email": "hosmelq@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "driftingly/rector-laravel": "^2.7",
    "friendsofphp/php-cs-fixer": "^3.95",
    "nesbot/carbon": "^3.15",
    "pestphp/pest-plugin-rector": "^5.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.1",
    "rector/rector": "^2.7",
    "spaze/phpstan-disallowed-calls": "^4.15",
    "symplify/easy-coding-standard": "^13.3",
    "thecodingmachine/phpstan-safe-rule": "^1.4",
    "thecodingmachine/safe": "^3.4",
    "ticketswap/phpstan-error-formatter": "^1.3",
    "tomasvotruba/type-coverage": "^2.5"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.54",
    "pestphp/pest": "^5.3",
    "pestphp/pest-plugin-agent": "^5.0",
    "shipmonk/composer-dependency-analyser": "^1.8",
    "symfony/process": "^8.1"
  },
  "conflict": {
    "fakerphp/faker": "<1.24",
    "symfony/event-dispatcher-contracts": "<2.5.4 || >=3.0 <3.5",
    "symfony/translation": "<6.4.8 || >=7.0 <7.0.8",
    "symfony/translation-contracts": "<2.5.4 || >=3.0 <3.5"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "HosmelQ\\PhpCodingStandard\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HosmelQ\\PhpCodingStandard\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "ecs": "ecs check --fix=true",
    "ecs:check": "ecs check",
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=4G",
    "rector": "rector",
    "test": "pest",
    "test-coverage": "pest --coverage"
  },
  "scripts-descriptions": {
    "ecs": "Format PHP code using the shared ECS set.",
    "ecs:check": "Check PHP formatting using the shared ECS set.",
    "phpstan": "Run PHPStan static analysis.",
    "rector": "Run Rector automated refactoring.",
    "test": "Run the test suite using Pest.",
    "test-coverage": "Run the test suite with code coverage using Pest."
  },
  "$schema": "https://getcomposer.org/schema.json"
}
