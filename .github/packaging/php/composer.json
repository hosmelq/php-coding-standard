{
  "name": "example/php-consumer",
  "description": "An isolated distribution smoke test.",
  "license": "MIT",
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "hosmelq/php-coding-standard": "1.0.0"
  },
  "autoload": {
    "psr-4": {
      "Example\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  }
}
