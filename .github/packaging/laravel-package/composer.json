{
  "name": "example/laravel-package-consumer",
  "description": "An isolated distribution smoke test.",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "illuminate/support": "^13.0"
  },
  "require-dev": {
    "hosmelq/php-coding-standard": "1.0.0",
    "larastan/larastan": "^3.12",
    "orchestra/testbench": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Example\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  }
}
