{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "zizmorcore/zizmor",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "managerFilePatterns": [".github/workflows/zizmor.yml"],
      "matchStrings": ["version: (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"]
    }
  ],
  "dependencyDashboard": true,
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "packageRules": [
    {
      "matchDepNames": ["pullfrog/pullfrog"],
      "matchManagers": ["github-actions"],
      "pinDigests": false
    },
    {
      "groupName": "composer dependencies",
      "matchManagers": ["composer"],
      "postUpdateOptions": ["composerWithAll"],
      "rangeStrategy": "replace"
    },
    {
      "matchDepNames": ["php"],
      "matchManagers": ["composer"],
      "rangeStrategy": "widen"
    },
    {
      "groupName": "github actions",
      "matchManagers": ["custom.regex", "github-actions"]
    }
  ],
  "rebaseWhen": "conflicted",
  "semanticCommits": "enabled",
  "separateMajorMinor": false
}
